{
  "name": "job-terminal",
  "private": true,
  "homepage": "./",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "collect": "node scripts/collect.mjs",
    "build": "vite build",
    "build:data": "npm run collect && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build:data && gh-pages -d dist",
    "deploy:cf": "npm run build:data && npx -y wrangler deploy",
    "dev:cf": "npx -y wrangler dev",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
